# ========================================================
# SaveItFromX Backend Environment Configuration (Render/Production)
# ========================================================

# --------------------------------------------------------
# 1. SECRETS (Sensitive credentials - never commit or expose)
# --------------------------------------------------------
# Supabase / PostgreSQL Database Connection URL (Session pooler port 5432 recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saveitfromx

# Cryptographic Session Secret (minimum 32 random characters in production)
SESSION_SECRET=change-this-to-a-secure-random-32-char-secret-in-production

# First-time Admin Bootstrap Password (used by npm run create-admin / bootstrap)
INITIAL_ADMIN_PASSWORD=change_this_secure_admin_password_123

# --------------------------------------------------------
# 2. SERVER-SIDE CONFIGURATION (Node.js runtime only - NOT browser-public)
# --------------------------------------------------------
NODE_ENV=production
PORT=3000

# CORS Allowed Origins: Exact comma-separated origins (no wildcards in production)
# Example: https://saveitfromx.vercel.app,https://www.saveitfromx.com
ALLOWED_ORIGINS=https://saveitfromx.vercel.app,https://www.saveitfromx.com

# Downloader & Subprocess Execution Timeouts (ms)
DOWNLOAD_TIMEOUT_MS=60000

# Concurrency & Work Queue Limits
MAX_CONCURRENT_DOWNLOADS=3

# Local File System Scratch Directory for Media Downloads
TEMP_DIR=/tmp/saveitfromx

# Initial Admin Email Identifier
INITIAL_ADMIN_EMAIL=admin@saveitfromx.com
